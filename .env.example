# Private local configuration. Copy to .env.local; never commit real values.
DATA_DRIVER=sqlite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: use an absolute path to keep the database outside the checkout.
# SQLITE_PATH=

# Optional emergency override. Omit to use the persistent demo:on/pause/off commands.
# DEMO_STATE=ai-paused
