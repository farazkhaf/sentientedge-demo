{
  "name": "sentientedge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-map.mjs",
    "prebuild": "node scripts/prepare-map.mjs",
    "build": "next build",
    "dev": "next dev",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "next start",
    "db:seed": "tsx scripts/seed.ts",
    "db:sql": "tsx scripts/seed.ts --sql",
    "demo:on": "tsx scripts/demo-state.ts online",
    "demo:pause": "tsx scripts/demo-state.ts ai-paused",
    "demo:off": "tsx scripts/demo-state.ts offline",
    "demo:remote:on": "wrangler d1 execute sentientedge --remote --command=\"UPDATE settings SET value='online' WHERE key='demo_state'\"",
    "demo:remote:pause": "wrangler d1 execute sentientedge --remote --command=\"UPDATE settings SET value='ai-paused' WHERE key='demo_state'\"",
    "demo:remote:off": "wrangler d1 execute sentientedge --remote --command=\"UPDATE settings SET value='offline' WHERE key='demo_state'\"",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:types": "wrangler types --env-interface CloudflareEnv",
    "cf:db:migrate": "wrangler d1 migrations apply sentientedge --local",
    "cf:db:seed": "npm run db:sql && wrangler d1 execute sentientedge --local --file=.data/seed.sql",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "postcf:build": "node scripts/verify-worker.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "@radix-ui/react-dialog": "1.1.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "maplibre-gl": "^6.13.0",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "2.15.4",
    "tailwind-merge": "^3.3.1",
    "zod": "3.25.76",
    "zustand": "5.0.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.3.3",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
